# Anthropic API key — get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Your Purifai Substack RSS feed URL
PURIFAI_FEED_URL=https://purifai.substack.com/feed

# Your Substack session cookie (substack.sid)
# How to get it:
#   1. Open substack.com in Chrome/Firefox and log in
#   2. Open DevTools → Application → Cookies → substack.com
#   3. Copy the value of the cookie named "substack.sid"
SUBSTACK_SESSION_COOKIE=your_session_cookie_here
